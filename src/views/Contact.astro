---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { clinic, tr, type Lang } from '../data/site';
import { ui } from '../data/ui';
import { href } from '../lib/paths';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui(lang);
const c = t.contactPage;
---
<Layout lang={lang} path="contact/" current="contact" title={c.metaTitle} description={c.metaDescription}>
  <PageHero lang={lang} eyebrow={c.eyebrow} title={c.title} lead={c.lead} crumbs={[{ label: t.nav.contact }]}>
    <div class="btns rv" style="--d:3;margin-top:24px" data-hero-cta>
      <a class="btn btn--primary" href={clinic.phone.href}><Icon name="phone" />{clinic.phone.display}</a>
      <a class="btn btn--ghost" href={clinic.whatsapp.href} target="_blank" rel="noopener"><Icon name="whatsapp" />WhatsApp {clinic.whatsapp.display}<span class="sr-only"> {t.external}</span></a>
    </div>
  </PageHero>
  <section class="section" style="padding-top:0">
    <div class="wrap t-layout">
      <form class="form rv" id="book" name="appointment" method="POST" action={href(lang, 'thanks/')} data-netlify="true" netlify-honeypot="company" data-form data-sending={c.sending} novalidate>
        <input type="hidden" name="form-name" value="appointment" />
        <input type="hidden" name="language" value={lang} />
        <p class="hidden"><label>Company <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <h2 style="font-size:1.6rem">{c.formTitle}</h2>
        <div class="row2">
          <div class="field"><label for="f-first">{c.first}</label><input id="f-first" name="first" autocomplete="given-name" required aria-describedby="f-first-err" /><span class="err" id="f-first-err" data-msg={c.errFirst} aria-live="polite"></span></div>
          <div class="field"><label for="f-last">{c.last}</label><input id="f-last" name="last" autocomplete="family-name" required aria-describedby="f-last-err" /><span class="err" id="f-last-err" data-msg={c.errLast} aria-live="polite"></span></div>
        </div>
        <div class="row2">
          <div class="field"><label for="f-tel">{c.tel}</label><input id="f-tel" name="tel" type="tel" autocomplete="tel" inputmode="tel" required aria-describedby="f-tel-err" /><span class="err" id="f-tel-err" data-msg={c.errTel} aria-live="polite"></span></div>
          <div class="field"><label for="f-mail">{c.mail}</label><input id="f-mail" name="email" type="email" autocomplete="email" /></div>
        </div>
        <div class="field"><label for="f-msg">{c.message}</label><textarea id="f-msg" name="message"></textarea></div>
        <p class="form-note">{c.consent} <a href={href(lang, 'privacy/')}>{t.privacy}</a></p>
        <p class="alert hidden" data-fail role="alert">{c.fail}</p>
        <button class="btn btn--primary" type="submit" style="justify-self:start">{c.send}</button>
      </form>
      <aside class="t-aside rv" style="--d:1">
        <h2>{t.address}</h2>
        <p style="margin:0">{clinic.address[lang][0]}<br />{clinic.address[lang][1]}</p>
        <a class="btn btn--ghost" href={clinic.maps} target="_blank" rel="noopener"><Icon name="pin" />{t.directions}<span class="sr-only"> {t.external}</span></a>
        <h2 style="margin-top:8px">{t.hoursTitle}</h2>
        <dl class="hours">{clinic.hours.map((h) => <div><dt>{tr(lang, h.days)}</dt><dd>{h.time}</dd></div>)}</dl>
        <p class="muted" style="margin:0;font-size:.92rem">{t.hoursNote}</p>
        <h2 style="margin-top:8px">{t.email}</h2>
        <p style="margin:0"><a href={`mailto:${clinic.email}`}>{clinic.email}</a></p>
      </aside>
    </div>
  </section>
</Layout>
