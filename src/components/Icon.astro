---
interface Props { name: 'arrow' | 'arrow-left' | 'phone' | 'whatsapp' | 'menu' | 'close' | 'star' | 'quote' | 'pin' | 'mail' | 'clock' | 'facebook' | 'instagram' | 'linkedin' | 'external' | 'layers' | 'pause' | 'play'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M19 12H5M11 6l-6 6 6 6" />}
  {name === 'phone' && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
  {name === 'whatsapp' && <><path d="M3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 8 19.3z" /><path d="M9 8.5c0 3 2.5 6 6 6.5l1.2-1.4-2-1-1 .8c-1-.4-2-1.4-2.4-2.4l.8-1-1-2z" /></>}
  {name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === 'close' && <path d="M6 6l12 12M18 6L6 18" />}
  {name === 'star' && <path fill="currentColor" stroke="none" d="M12 2.6l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5L2.6 9.4l6.5-.9z" />}
  {name === 'quote' && <path fill="currentColor" stroke="none" d="M4 18v-5.2C4 8.7 6 6.1 9.6 5l.9 1.6C8.4 7.5 7.4 9 7.3 11H10v7H4zm10 0v-5.2c0-4.1 2-6.7 5.6-7.8l.9 1.6c-2.1.9-3.1 2.4-3.2 4.4H20v7h-6z" />}
  {name === 'pin' && <><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></>}
  {name === 'facebook' && <path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H7v4h3v7h4v-7h3l1-4h-4V8a0 0 0 0 1 0 0z" />}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" /></>}
  {name === 'linkedin' && <><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></>}
  {name === 'external' && <path d="M14 5h5v5M19 5l-8 8M18 14v5H5V6h5" />}
  {name === 'layers' && <path d="M12 3l9 5-9 5-9-5 9-5zM3 13l9 5 9-5" />}
  {name === 'pause' && <path d="M9 6v12M15 6v12" />}
  {name === 'play' && <path d="M8 5l11 7-11 7z" />}
</svg>
