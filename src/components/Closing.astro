---
import Icon from './Icon.astro';
import { clinic, tr, type Lang } from '../data/site';
import { ui } from '../data/ui';
import { href } from '../lib/paths';
interface Props { lang: Lang; title?: string; text?: string }
const { lang, title, text } = Astro.props;
const t = ui(lang);
---
<section class="section closing-band" aria-labelledby="closing-h">
  <div class="wrap"><div class="closing-panel">
    <div class="closing">
      <div>
        <p class="eyebrow rv">{t.nav.contact}</p>
        <h2 id="closing-h" class="rv" style="--d:1">{title ?? t.home_.closingTitle}</h2>
        <p class="lead rv" style="--d:2;margin-top:14px">{text ?? t.home_.closingText}</p>
      </div>
      <div class="btns rv" style="--d:2">
        <a class="btn btn--primary" href={href(lang, 'contact/')}>{t.book}<Icon name="arrow" class="arr" /></a>
        <a class="btn btn--ghost" href={clinic.phone.href}><Icon name="phone" />{clinic.phone.display}</a>
        <a class="btn btn--ghost" href={clinic.whatsapp.href} target="_blank" rel="noopener"><Icon name="whatsapp" />{t.whatsapp}<span class="sr-only"> {t.external}</span></a>
      </div>
    </div>
    <div class="contact-grid">
      <div>
        <h3>{t.address}</h3>
        <p style="margin:0">{clinic.address[lang][0]}<br />{clinic.address[lang][1]}</p>
        <p style="margin:10px 0 0"><a class="link" href={clinic.maps} target="_blank" rel="noopener">{t.directions}<Icon name="external" /><span class="sr-only"> {t.external}</span></a></p>
      </div>
      <div>
        <h3>{t.hoursTitle}</h3>
        <dl class="hours">{clinic.hours.map((h) => <div><dt>{tr(lang, h.days)}</dt><dd>{h.time}</dd></div>)}</dl>
        <p class="muted" style="margin:10px 0 0;font-size:.9rem">{t.hoursNote}</p>
      </div>
      <div>
        <h3>{t.phone} · {t.email}</h3>
        <p style="margin:0"><a href={clinic.phone.href}>{clinic.phone.display}</a> / <a href={clinic.phone2.href}>{clinic.phone2.display.slice(-6)}</a><br /><a href={`mailto:${clinic.email}`}>{clinic.email}</a></p>
      </div>
    </div>
  </div></div>
</section>
