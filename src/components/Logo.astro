---
// The clinic's logo rebuilt as SVG + text so it stays sharp (the supplied PNG is 312 × 48 px).
import type { Lang } from '../data/site';
interface Props { lang: Lang; href: string }
const { lang, href } = Astro.props;
---
<a class="brand" href={href} aria-label={lang === 'el' ? 'Οδοντιατρικό Κέντρο Δρ Άδωνι Παναγίδη, αρχική σελίδα' : 'Dr Adonis Panagidis Dental Center, home'}>
  <svg viewBox="0 0 34 40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M10.5 3.5C5.4 3.5 2.5 7.3 2.5 12.6c0 3.8 1.3 6.5 2.3 10.1 1.1 4.6 1.6 13.8 4.6 13.8 2.3 0 2.7-4.2 3.5-7.4.6-2.2 1.3-3.5 4.1-3.5s3.5 1.3 4.1 3.5c.8 3.2 1.2 7.4 3.5 7.4 3 0 3.5-9.2 4.6-13.8 1-3.6 2.3-6.3 2.3-10.1 0-5.3-2.9-9.1-8-9.1-3.3 0-4.4 1.6-6.5 1.6s-3.2-1.6-6.5-1.6z" />
  </svg>
  <span class="brand-text"><span class="brand-kicker">Dental Center</span><span class="brand-name">Dr. Adonis Panagidis</span></span>
</a>
